# Aligo 智能旅行助手 - 环境变量配置
# 复制此文件为 .env 并填入真实值

# ── LLM 配置（必填）────────────────────────────────────
# OpenAI 兼容接口的 API Key（与下方 BASE_URL 的服务商对应）
ALIGO_API_KEY=your_api_key_here

# 模型名称（可选，默认 glm-5.2-fast-preview）
# ALIGO_MODEL_NAME=glm-5.2-fast-preview

# OpenAI 兼容 API 地址（可选，默认阿里云 MAAS）
# 可切换 DeepSeek：ALIGO_BASE_URL=https://api.deepseek.com/v1
# ALIGO_BASE_URL=https://ws-qvg9u4gn3ewyjs3t.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ── 高德天气（可选）────────────────────────────────────
# 不填则天气查询降级为网络搜索；免费开放平台：https://lbs.amap.com
# AMAP_API_KEY=your_amap_api_key_here

# ── RAG 向量模型（可选）────────────────────────────────
# 首次运行自动从 HuggingFace 下载（约 90MB），缓存到 data/models/
# ALIGO_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── PostgreSQL 持久化（可选）───────────────────────────
# 不填则回退 JSON 文件模式（data/memory/）
# ALIGO_DATABASE_URL=postgresql://user:password@localhost:5432/aligo

# ── Redis 缓存（可选）──────────────────────────────────
# 不填则回退进程内 dict
# ALIGO_REDIS_URL=redis://localhost:6379/0
# ALIGO_CACHE_TTL=3600

# ── 生产环境 CORS（可选，逗号分隔）────────────────────
# CORS_ORIGINS=https://your-domain.com

# ── HuggingFace 镜像（可选，国内加速模型下载）──────────
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1
