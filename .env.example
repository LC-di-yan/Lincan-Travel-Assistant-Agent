# Aligo 差旅出行助手 — 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 gitignore，不会进仓库。
# 提交前自查：python tools/scan_secrets.py

# ── 主通道（必填）──────────────────────────────────────────────
# 任何 OpenAI 兼容接口都行：DeepSeek / 阿里云百炼 / 硅基流动 / 自建中转 …
ALIGO_API_KEY=your_api_key_here
ALIGO_MODEL_NAME=your_model_name_here
ALIGO_BASE_URL=https://your-endpoint.example.com/v1

# ── 备用通道（建议配，主通道 401/403/429/5xx/超时自动切换）──────
# 三个变量按位置一一对应；API_KEYS 可少写，缺省沿用主 key
# ALIGO_FALLBACK_BASE_URLS=https://backup-a.example.com/v1,https://backup-b.example.com/v1
# ALIGO_FALLBACK_MODEL_NAMES=model-a,model-b
# ALIGO_FALLBACK_API_KEYS=sk-backup-a,sk-backup-b

# 整条通道链总预算（秒）。超时即给用户提示，不让页面无限「处理中」
# ALIGO_LLM_TOTAL_TIMEOUT=110

# 启动时探活一次，日志直接打出哪条通道可用（默认开启）
# ALIGO_LLM_PROBE_ON_STARTUP=1

# ── 可选能力 ─────────────────────────────────────────────────
# 高德天气（不填则天气查询降级为联网搜索）
# 免费申请：https://lbs.amap.com
# AMAP_API_KEY=your_amap_api_key_here

# 语音朗读（小米 MiMo TTS，不填则朗读功能不可用，不影响行程）
# MIMO_API_KEY=your_mimo_api_key_here
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_TTS_VOICE=冰糖

# 语音播报文案（可选，独立于主对话模型）
# NARRATION_API_KEY=your_narration_api_key
# NARRATION_BASE_URL=https://your-endpoint.example.com/v1
# NARRATION_MODEL=glm-5.2

# ── 存储（都可选，空则回退本地文件）──────────────────────────
# PostgreSQL 持久化；不填用 data/memory/*.json
# ALIGO_DATABASE_URL=postgresql://user:password@localhost:5432/aligo

# Redis 缓存；不填用进程内 dict
# ALIGO_REDIS_URL=redis://localhost:6379/0
# ALIGO_CACHE_TTL=3600

# ── 模型下载 ─────────────────────────────────────────────────
# 国内加速 HuggingFace（首次会下载 ~90MB 的 bge-small-zh）
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1

# 服务监听
# ALIGO_HOST=0.0.0.0
# ALIGO_PORT=3003
# CORS_ORIGINS=http://localhost:5173
