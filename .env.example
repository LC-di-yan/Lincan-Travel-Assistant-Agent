# Aligo 差旅出行助手 - 环境变量配置
# 复制此文件为 .env 并填入真实值

# LLM API Key (必填)
ALIGO_API_KEY=your_api_key_here

# LLM 模型名称 (可选，默认 mimo-v2-pro)
# ALIGO_MODEL_NAME=mimo-v2-pro

# LLM API 地址 (可选，默认小米 MiMo)
# ALIGO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 高德天气 Amap API Key (可选，天气查询降级为网络搜索)
# 免费开放平台：https://lbs.amap.com
# AMAP_API_KEY=your_amap_api_key_here

# PostgreSQL 持久化存储 (可选，空则回退 JSON 文件模式)
# ALIGO_DATABASE_URL=postgresql://user:password@localhost:5432/aligo

# Redis 缓存层 (可选，空则回退进程内 dict)
# ALIGO_REDIS_URL=redis://localhost:6379/0
# ALIGO_CACHE_TTL=3600
