# 复制为 .env 后仅在本地填写；不要提交 .env。
# 对话模型：OpenAI 兼容 API 地址（通常以 /v1 结尾）。
ALIGO_API_KEY=
ALIGO_BASE_URL=
ALIGO_MODEL_NAME=
ALIGO_ITINERARY_MODEL_NAME=
ALIGO_LLM_PROBE_ON_STARTUP=0
ALIGO_FALLBACK_BASE_URLS=
ALIGO_FALLBACK_MODEL_NAMES=
ALIGO_FALLBACK_API_KEYS=

# 可选外部服务
AMAP_API_KEY=
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_TTS_MODEL=mimo-v2.5-tts
NARRATION_API_KEY=
NARRATION_BASE_URL=
NARRATION_MODEL=
ALIGO_DECISION_MODE=off
NEOHOUSE_API_KEY=
NEOHOUSE_BASE_URL=
NEOHOUSE_MODEL=

# 空值使用本地 JSON 和进程内缓存。个人中心本地可开；公网应使用 HTTPS。
ALIGO_DATABASE_URL=
ALIGO_REDIS_URL=
ALIGO_PERSONAL_CENTER_ENABLED=1
CORS_ORIGINS=
# 留空则生成本地签名文件。生产可通过受保护的环境变量配置至少 32 字符的密钥。
ALIGO_SESSION_SECRET=
