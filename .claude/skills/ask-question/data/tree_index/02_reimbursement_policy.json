            5,
            9
          ],
          "children": []
        },
        {
          "id": "02#h1-1#h2-2",
          "title": "2. 特殊情况时限",
          "summary": "跨年度出差：应在当年12月31日前完成报销",
          "line_range": [
            10,
            14
          ],
          "children": []
        },
        {
          "id": "02#h1-1#h2-3",
          "title": "3. 逾期处理",
