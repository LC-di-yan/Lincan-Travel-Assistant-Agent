          "line_range": [
            22,
            42
          ],
          "children": []
        },
        {
          "id": "02#h1-2#h2-2",
          "title": "2. 发票基本要求",
          "summary": "抬头：必须为公司全称\"阿里巴巴（中国）有限公司\"或所属分公司全称",
          "line_range": [
            43,
            49
          ],
          "children": []
        },
        {
          "id": "02#h1-2#h2-3",
          "title": "3. 电子发票要求",
          "summary": "电子发票与纸质发票具有同等法律效力",
          "line_range": [
            50,
            55
          ],
          "children": []
        },
        {
          "id": "02#h1-2#h2-4",
          "title": "4. 特殊票据处理",
          "summary": "火车票遗失：可持身份证到车站打印\"报销凭证\"",
          "line_range": [
            56,
            60
          ],
          "children": []
        }
      ]
    },
    {
