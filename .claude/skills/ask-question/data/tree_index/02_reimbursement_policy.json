      "line_range": [
        162,
        178
      ],
      "children": [
        {
          "id": "02#h1-7#h2-1",
          "title": "1. 发票查验",
          "summary": "财务部会对所有发票进行真伪查验",
          "line_range": [
            164,
            168
          ],
          "children": []
        },
        {
          "id": "02#h1-7#h2-2",
          "title": "2. 发票保存",
          "summary": "纸质发票：由财务部统一保存，保存期限7年",
          "line_range": [
            169,
            173
          ],
          "children": []
        },
        {
          "id": "02#h1-7#h2-3",
          "title": "3. 发票丢失处理",
          "summary": "遗失发票：需出具书面说明，经主管签字确认",
          "line_range": [
            174,
            178
          ],
          "children": []
        }
      ]
    },
    {
      "id": "02#h1-8",
      "title": "八、常见问题处理",
      "summary": "发票抬头错误、发票金额超标、多人共同出差、报销金额错误",
      "line_range": [
        179,
        200
      ],
      "children": [
        {
          "id": "02#h1-8#h2-1",
          "title": "1. 发票抬头错误",
          "summary": "可联系开票方重新开具（需要原发票作废或红冲）",
          "line_range": [
            181,
            185
          ],
          "children": []
        },
        {
          "id": "02#h1-8#h2-2",
          "title": "2. 发票金额超标",
          "summary": "未经审批超标：按标准金额报销",
          "line_range": [
            186,
            190
          ],
          "children": []
        },
        {
          "id": "02#h1-8#h2-3",
          "title": "3. 多人共同出差",
          "summary": "发票可由一人代为统一开具",
          "line_range": [
            191,
            195
          ],
          "children": []
        },
        {
          "id": "02#h1-8#h2-4",
          "title": "4. 报销金额错误",
          "summary": "提交前仔细核对",
          "line_range": [
            196,
            200
          ],
          "children": []
        }
      ]
    },
