      "line_range": [
        134,
        161
      ],
      "children": [
        {
          "id": "02#h1-6#h2-1",
          "title": "1. 行李费用",
          "summary": "托运行李费：航空公司免费额度内不产生费用",
          "line_range": [
            136,
            140
          ],
          "children": []
        },
        {
          "id": "02#h1-6#h2-2",
          "title": "2. 通讯费用",
          "summary": "国内通话：不单独报销（计入个人话费补贴）",
          "line_range": [
            141,
            145
          ],
          "children": []
        },
        {
          "id": "02#h1-6#h2-3",
          "title": "3. 签证费用",
          "summary": "签证费：全额报销",
          "line_range": [
            146,
            151
          ],
          "children": []
        },
        {
          "id": "02#h1-6#h2-4",
          "title": "4. 保险费用",
          "summary": "公司统一购买的差旅意外险：无需个人报销",
          "line_range": [
            152,
            155
          ],
          "children": []
        },
        {
          "id": "02#h1-6#h2-5",
          "title": "5. 其他合理费用",
          "summary": "会议资料打印费：可报销",
          "line_range": [
            156,
            161
          ],
          "children": []
        }
      ]
    },
    {
      "id": "02#h1-7",
      "title": "七、发票管理",
