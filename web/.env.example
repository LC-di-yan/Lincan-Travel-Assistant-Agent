# Aligo 前端 - 智能追问 LLM 配置（可选）
# 复制本文件为 web/.env 后重启前端；不配置则「智能追问」功能自动降级隐藏
# OpenAI 兼容接口，可与后端使用同一服务商

# 智能追问使用的 OpenAI 兼容 Chat Completions 地址
VITE_LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# API Key
VITE_LLM_API_KEY=your_api_key_here

# 模型名称（可选，默认 deepseek-chat）
VITE_LLM_MODEL=deepseek-chat
